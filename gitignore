# ===== Dữ liệu thật (KHÔNG commit) =====
# Các DB SQLite chứa câu hỏi/ma trận/thí sinh/kết quả thi thật
/data/*.sqlite
/data/*.sqlite-journal
/data/*.sqlite-wal
/data/*.sqlite-shm
!/data/.gitkeep

# Gói đề thi đã mã hoá dùng cho máy thi (bundle.dat / bundle*.dat.part*)
# + thư mục cache do index.php tự tạo khi giải nén bundle (_cache_*)
/bundle-dat/
!/bundle-dat/.gitkeep

# Ảnh/âm thanh câu hỏi do người dùng upload
/uploads/*
!/uploads/.gitkeep

# ===== Rác hệ điều hành / IDE =====
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log

# ===== Nếu sau này thêm cấu hình môi trường =====
.env
